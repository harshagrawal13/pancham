# Copy to server/.env on kamaji (gitignored, mode 0600). Read by server.py and auth_cli.py.

# Who may sign in. Admins may also sign in, and may make and change global notations.
# An empty list lets nobody in: the server refuses to start.
PANCHAM_ADMIN_EMAILS=you@example.com
PANCHAM_AUTH_EMAILS=

# Free option A, no new account: your own Gmail with an app password
# (Google Account > Security > 2-Step Verification > App passwords).
#   PANCHAM_SMTP_HOST=smtp.gmail.com
#   PANCHAM_SMTP_PORT=587
#   PANCHAM_SMTP_USER=you@gmail.com
#   PANCHAM_SMTP_PASSWORD=<the 16-character app password>
#   PANCHAM_AUTH_EMAIL_FROM=Pancham <you@gmail.com>
# Free option B: Resend (free tier), below.
# The sign-in code goes out through Resend. Until the sender's domain is verified there, Resend
# delivers only to the account owner; for anyone else, pass a code on with
#   python3 server/auth_cli.py code <email>
RESEND_API_KEY=
PANCHAM_AUTH_EMAIL_FROM=Pancham <onboarding@resend.dev>
